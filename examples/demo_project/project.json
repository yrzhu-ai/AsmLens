{
  "name": "AsmLens 演示工程",
  "version": "1.0.0",
  "chrom_sizes": "chrom.sizes",
  "ref_chrom_sizes": "ref.chrom.sizes",
  "problems_file": "problems.tsv",
  "tracks": [
    {
      "id": "query_gaps",
      "name": "组装 Gap (N)",
      "type": "bed",
      "file": "tracks/query_gaps.bed",
      "color": "#2c3e50",
      "height": 22,
      "kind": "GAP_Q",
      "genome": "query"
    },
    {
      "id": "coverage",
      "name": "Reads 覆盖",
      "type": "bedgraph",
      "file": "tracks/coverage.bedgraph",
      "color": "#377eb8",
      "height": 110,
      "kind": "COV_Q",
      "genome": "query",
      "style": "igv_coverage"
    },
    {
      "id": "zero_coverage",
      "name": "零覆盖（叠图）",
      "type": "bed",
      "file": "tracks/zero_coverage.bed",
      "color": "#e41a1c",
      "height": 26,
      "kind": "ZERO_COV",
      "genome": "query",
      "ui": "overlay"
    },
    {
      "id": "query_lowcov_attribution",
      "name": "映射归因（叠图）",
      "type": "bed",
      "file": "tracks/query_lowcov_attribution.bed",
      "color": "#d68910",
      "height": 28,
      "kind": "ATTR_Q",
      "genome": "query",
      "ui": "overlay"
    },
    {
      "id": "craq_CRE",
      "name": "CRAQ 区域错误 (CRE)",
      "type": "bed",
      "file": "tracks/craq_CRE.bed",
      "color": "#984ea3",
      "height": 26,
      "kind": "CRE",
      "genome": "query"
    },
    {
      "id": "low_qv",
      "name": "低 QV（≤30）",
      "type": "bed",
      "file": "tracks/low_qv.bed",
      "color": "#4daf4a",
      "height": 26,
      "kind": "LOW_QV",
      "genome": "query"
    }
  ],
  "tables": {
    "query_lowcov_map_to_ref": "query_lowcov_map_to_ref.tsv",
    "ref_lowcov_map_to_query": null
  },
  "summary": {
    "query_lowcov_status": {
      "both_lowcov": 2,
      "mapped_not_lowcov": 2,
      "unmapped": 1
    },
    "query_gap_count": 5
  },
  "defaults": {
    "problem_only": true,
    "flank_bp": 20000
  }
}
